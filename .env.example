# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ===== Wompi =====
# Llave pública (se expone al frontend) y firma de integridad (se calcula en backend).
WOMPI_PUBLIC_KEY="pub_prod_xxx"
WOMPI_PRIVATE_KEY="prv_prod_xxx"
WOMPI_EVENTS_SECRET="prod_events_xxx"
WOMPI_INTEGRITY_SECRET="prod_integrity_xxx"
# "production" o "sandbox"
WOMPI_ENV="production"
# Base pública del sitio, usada para el redirect-url de Wompi (sin slash final).
PUBLIC_BASE_URL="https://tudominio.com"
# Puerto interno del servidor (nginx hace proxy a este). Por defecto 3000.
PORT="3000"

# ===== Firebase Admin (recomendado en producción) =====
# JSON de la cuenta de servicio en una sola línea para que el backend escriba pedidos
# sin depender de las reglas de Firestore. Alternativa: GOOGLE_APPLICATION_CREDENTIALS
# (ruta a archivo) o un archivo service-account.json en la raíz.
FIREBASE_SERVICE_ACCOUNT=""
# GOOGLE_APPLICATION_CREDENTIALS="/ruta/al/service-account.json"
# Copia de la llave pública expuesta vía Vite al cliente (opcional).
VITE_WOMPI_PUBLIC_KEY="pub_prod_xxx"

# ===== SMTP / Resend =====
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""
SMTP_FROM_VENTAS="Fly and Chill <ventas@flyandchill.store>"
SMTP_FROM_NEWSLETTER="Fly and Chill <newsletter@flyandchill.store>"
